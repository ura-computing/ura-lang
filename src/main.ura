fn pick(b i32) i32:
    return if b == 10: 12 else: 15

fn main() i32:
    x i32 = if pick(10) == 12: 30 elif False: 0 else: 1
    y i32 = 7
    if x == 30: y = 0 else: y = 100
    return x + pick(10) + y

